' --- Surrounding Boundaries (Open Add Space) ---
With Boundary
    .Xmin "expanded open"
    .Xmax "expanded open"
    .Ymin "expanded open"
    .Ymax "expanded open"
    .Zmin "expanded open"
    .Zmax "expanded open"
End With

' --- Waveguide Port on CPW Feed (Y = l_sub = 98.09 mm) ---
With Port
    .Reset
    .PortNumber "1"
    .Label "Feed_Port"
    .NumberOfModes "1"
    .AdjustPolarization "False"
    .PolarizationAngle "0.0"
    .ReferencePlaneDistance "0"
    .Coordinates "Free"
    .Orientation "Ymax"
    .PortOnBound "False"
    .Xrange "-23.5000", "-16.5000"
    .Zrange "-1.0080", "0.5000"
    .Yrange "98.0900", "98.0900"
    .Create
End With

